<section style="max-width:1000px;margin:65px auto;padding:0 5vw"><h1 class="section-heading">Buscar</h1><form action="{{ routes.search_url }}"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Busca destinos o experiencias"><button class="ai-submit">Buscar</button></form>{% if search.performed %}{% for item in search.results %}<p><a href="{{ item.url }}">{{ item.title | escape }}</a></p>{% else %}<p>No encontramos resultados.</p>{% endfor %}{% endif %}</section>{% schema %}{"name":"Búsqueda","settings":[]}{% endschema %}