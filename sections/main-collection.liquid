<section style="max-width:1320px;margin:65px auto;padding:0 5vw"><h1 class="section-heading">{{ collection.title | escape }}</h1><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:24px">{% for product in collection.products %}<article><a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.featured_image.alt }}{% endif %}<h2>{{ product.title | escape }}</h2></a><p>{{ product.price | money }}</p></article>{% else %}<p>Pronto encontrarás experiencias para explorar el Perú.</p>{% endfor %}</div></section>{% schema %}{"name":"Colección","settings":[]}{% endschema %}