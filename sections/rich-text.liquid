{% style %}.brand-story{padding:90px 5vw;text-align:center;background:#f1f3ed}.brand-story>div{max-width:850px;margin:auto}.brand-story h2{font:400 clamp(2.3rem,4vw,3.8rem)/1.1 var(--display);color:var(--forest)}.brand-story p{color:#627168;line-height:1.8;font-size:1.05rem}{% endstyle %}<section class="brand-story" id="nosotros"><div><p class="section-kicker">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p></div></section>{% schema %}{"name":"Nuestra propuesta","settings":[{"type":"text","id":"kicker","label":"Antetítulo","default":"Viajar informado también es viajar mejor"},{"type":"text","id":"heading","label":"Título","default":"El Perú tiene una historia esperando por ti."},{"type":"textarea","id":"body","label":"Descripción","default":"Queremos acercarte a los destinos del país con información útil, inspiración y herramientas inteligentes para que planifiques cada aventura con mayor confianza."}],"presets":[{"name":"Nuestra propuesta"}]}{% endschema %}