{% style %}.experience-section{padding:clamp(70px,8vw,105px) 5vw;background:#f0f2eb}.experience-wrap{max-width:1320px;margin:auto}.experience-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:42px}.experience-card{position:relative;min-height:320px;overflow:hidden;border-radius:5px;background:#234638;color:white;text-decoration:none}.experience-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s}.experience-card:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(5,24,18,.82),rgba(5,24,18,.03) 80%)}.experience-card:hover img{transform:scale(1.04)}.experience-content{position:absolute;z-index:1;left:22px;right:22px;bottom:22px}.experience-content span{font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:#e7d5ae}.experience-content h3{font:400 1.65rem var(--display);margin:8px 0}.experience-content p{font-size:.84rem;line-height:1.55;color:#ffffffd9;margin:0}.experience-arrow{position:absolute;z-index:2;right:20px;top:20px;width:42px;height:42px;border:1px solid #ffffffa6;border-radius:50%;display:grid;place-items:center}@media(max-width:900px){.experience-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.experience-card{min-height:300px}}@media(max-width:520px){.experience-grid{grid-template-columns:1fr}.experience-card{min-height:340px}}{% endstyle %}<section class="experience-section" id="experiencias"><div class="experience-wrap"><p class="section-kicker">{{ section.settings.kicker | escape }}</p><h2 class="section-heading">{{ section.settings.heading | escape }}</h2><p class="section-intro">{{ section.settings.intro | escape }}</p><div class="experience-grid">{% for block in section.blocks %}<a class="experience-card" href="{{ block.settings.link | default: '#planifica' }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: widths: '360, 540, 800', sizes: '(min-width: 900px) 23vw, (min-width: 520px) 44vw, 90vw', loading: 'lazy', alt: block.settings.image.alt }}{% else %}<img src="{{ block.settings.fallback_image }}" alt="{{ block.settings.title | escape }}" width="800" height="1000" loading="lazy">{% endif %}<span class="experience-arrow" aria-hidden="true">↗</span><div class="experience-content"><span>{{ block.settings.eyebrow | escape }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.description | escape }}</p></div></a>{% endfor %}</div></div></section>{% schema %}{"name":"Experiencias para explorar","settings":[{"type":"text","id":"kicker","label":"Antetítulo","default":"Elige cómo quieres vivir el Perú"},{"type":"text","id":"heading","label":"Título","default":"Un país, muchas formas de descubrirlo."},{"type":"textarea","id":"intro","label":"Introducción","default":"Encuentra una experiencia que vaya contigo: desde rutas culturales hasta paisajes de naturaleza y aventura."}],"blocks":[{"type":"experience","name":"Experiencia","settings":[{"type":"image_picker","id":"image","label":"Fotografía"},{"type":"text","id":"fallback_image","label":"URL alternativa"},{"type":"text","id":"eyebrow","label":"Categoría","default":"Naturaleza"},{"type":"text","id":"title","label":"Título","default":"Paisajes únicos"},{"type":"textarea","id":"description","label":"Descripción"},{"type":"url","id":"link","label":"Enlace"}]}],"max_blocks":4,"presets":[{"name":"Experiencias para explorar","blocks":[{"type":"experience","settings":{"eyebrow":"Historia y cultura","title":"Rutas culturales","description":"Descubre ciudades, tradiciones y legado ancestral.","fallback_image":"https://commons.wikimedia.org/wiki/Special:FilePath/Panorama_of_Machu_Picchu.jpg?width=900"}},{"type":"experience","settings":{"eyebrow":"Desierto y costa","title":"Aventura costera","description":"Explora oasis, playas y paisajes del litoral.","fallback_image":"https://commons.wikimedia.org/wiki/Special:FilePath/Oasis_Huacachina_-_Peru.jpg?width=900"}},{"type":"experience","settings":{"eyebrow":"Montaña","title":"Aventura andina","description":"Conoce rutas de altura y escenarios naturales.","fallback_image":"https://commons.wikimedia.org/wiki/Special:FilePath/Rainbow_Mountain_Peru.jpg?width=900"}},{"type":"experience","settings":{"eyebrow":"Amazonía","title":"Naturaleza viva","description":"Acércate a la biodiversidad del bosque tropical.","fallback_image":"https://commons.wikimedia.org/wiki/Special:FilePath/Tambopata.jpg?width=900"}}]}]}{% endschema %}