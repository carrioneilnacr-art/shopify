{% style %}.faq-section{padding:clamp(70px,8vw,105px) 5vw;background:#fff}.faq-wrap{max-width:1000px;margin:auto}.faq-head{text-align:center;max-width:700px;margin:0 auto 40px}.faq-head .section-intro{margin-inline:auto}.faq-list{border-top:1px solid #dfe4dc}.faq-item{border-bottom:1px solid #dfe4dc}.faq-item summary{list-style:none;cursor:pointer;min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:20px;font:400 1.25rem var(--display);color:var(--forest)}.faq-item summary::-webkit-details-marker{display:none}.faq-item summary:after{content:'+';font:400 1.5rem var(--body);color:#9b8557}.faq-item[open] summary:after{content:'−'}.faq-answer{padding:0 35px 24px 0;color:#68776f;line-height:1.8;max-width:800px}@media(max-width:600px){.faq-item summary{font-size:1.08rem;min-height:62px}.faq-section{padding:65px 5vw}}{% endstyle %}<section class="faq-section" id="preguntas"><div class="faq-wrap"><div class="faq-head"><p class="section-kicker">{{ section.settings.kicker | escape }}</p><h2 class="section-heading">{{ section.settings.heading | escape }}</h2><p class="section-intro">{{ section.settings.intro | escape }}</p></div><div class="faq-list">{% for block in section.blocks %}<details class="faq-item" {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><div class="faq-answer">{{ block.settings.answer }}</div></details>{% endfor %}</div></div></section>{% schema %}{"name":"Preguntas frecuentes","settings":[{"type":"text","id":"kicker","label":"Antetítulo","default":"Antes de viajar"},{"type":"text","id":"heading","label":"Título","default":"Resolvemos tus dudas."},{"type":"textarea","id":"intro","label":"Introducción","default":"Conoce cómo funciona Perú Explora IA y qué debes verificar antes de organizar tu viaje."}],"blocks":[{"type":"question","name":"Pregunta","settings":[{"type":"text","id":"question","label":"Pregunta","default":"¿Puedo reservar un viaje desde la página?"},{"type":"richtext","id":"answer","label":"Respuesta","default":"<p>Por ahora, la plataforma ofrece inspiración, información y recomendaciones de itinerarios. No confirma reservas ni disponibilidad.</p>"}]}],"max_blocks":8,"presets":[{"name":"Preguntas frecuentes","blocks":[{"type":"question","settings":{"question":"¿Puedo reservar un viaje desde la página?","answer":"<p>Por ahora, Perú Explora IA ofrece información y recomendaciones para planificar. No confirma reservas ni disponibilidad.</p>"}},{"type":"question","settings":{"question":"¿La IA muestra precios actualizados?","answer":"<p>Los presupuestos generados son orientativos. Las tarifas, horarios, entradas y disponibilidad deben confirmarse con operadores y fuentes oficiales antes de viajar.</p>"}},{"type":"question","settings":{"question":"¿Qué destinos puedo consultar?","answer":"<p>El enfoque de la plataforma es el turismo dentro del Perú. Puedes pedir ideas para destinos de costa, sierra y selva.</p>"}},{"type":"question","settings":{"question":"¿Qué información debo compartir?","answer":"<p>Tu ciudad de salida, cantidad de días, presupuesto aproximado, número de viajeros y tipo de experiencia que te interesa.</p>"}}]}]}{% endschema %}