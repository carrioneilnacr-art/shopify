{% style %}
.destinations{padding:clamp(70px,9vw,118px) 5vw;background:var(--cream)}
.section-wrap{max-width:1320px;margin:auto}
.destination-heading-row{display:grid;grid-template-columns:1fr .8fr;gap:40px;align-items:end}
.section-heading{font:400 clamp(2.4rem,4.5vw,4.25rem)/1.04 var(--display);color:var(--forest);max-width:740px;margin:14px 0;letter-spacing:-.04em}
.section-intro{color:#637169;max-width:560px;line-height:1.8;justify-self:end}
.destination-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:48px}
.destination-card{min-width:0}
.destination-image{display:block;aspect-ratio:4/4.8;overflow:hidden;border-radius:4px;background:#e6e9e1}
.destination-image img{width:100%;height:100%;object-fit:cover;transition:transform .65s}
.destination-card:hover .destination-image img{transform:scale(1.035)}
.destination-meta{font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:#718078;margin:19px 0 8px}
.destination-name{font:400 clamp(1.55rem,2.4vw,2rem) var(--display);color:var(--forest);margin:0}
.destination-desc{font-size:.91rem;line-height:1.7;color:#65736b;max-width:360px}
.destination-link{display:inline-flex;align-items:center;gap:8px;margin-top:9px;font-size:.85rem;font-weight:600;color:var(--emerald);text-decoration:none}
@media(max-width:850px){.destination-heading-row{grid-template-columns:1fr;gap:12px}.section-intro{justify-self:start}.destination-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:560px){.destination-grid{grid-template-columns:1fr;gap:34px}.destination-image{aspect-ratio:5/4}.destinations{padding:68px 5vw}}
{% endstyle %}
<section class="destinations" id="destinos"><div class="section-wrap"><div class="destination-heading-row"><div><p class="section-kicker">{{ section.settings.kicker | escape }}</p><h2 class="section-heading">{{ section.settings.heading | escape }}</h2></div><p class="section-intro">{{ section.settings.intro | escape }}</p></div><div class="destination-grid">{% for block in section.blocks %}<article class="destination-card" {{ block.shopify_attributes }}><a class="destination-image" href="{{ block.settings.link | default: '#planifica' }}" aria-label="Conocer {{ block.settings.name | escape }}">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 28vw, (min-width: 560px) 44vw, 90vw', loading: 'lazy', alt: block.settings.image.alt }}{% else %}<img src="{{ block.settings.fallback_image }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="900" height="1080">{% endif %}</a><p class="destination-meta">{{ block.settings.region | escape }}</p><h3 class="destination-name">{{ block.settings.name | escape }}</h3><p class="destination-desc">{{ block.settings.description | escape }}</p><a class="destination-link" href="{{ block.settings.link | default: '#planifica' }}">Descubrir el destino <span aria-hidden="true">↗</span></a></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Destinos destacados","settings":[{"type":"text","id":"kicker","label":"Antetítulo","default":"Inspiración para tu próxima ruta"},{"type":"text","id":"heading","label":"Título","default":"Lugares que hacen único al Perú."},{"type":"textarea","id":"intro","label":"Introducción","default":"Desde ciudades milenarias hasta oasis entre dunas y montañas de colores: encuentra el paisaje que conecta contigo."}],"blocks":[{"type":"destination","name":"Destino","settings":[{"type":"image_picker","id":"image","label":"Fotografía"},{"type":"text","id":"fallback_image","label":"URL de fotografía alternativa"},{"type":"text","id":"region","label":"Región","default":"Cusco · Andes"},{"type":"text","id":"name","label":"Nombre","default":"Machu Picchu"},{"type":"textarea","id":"description","label":"Descripción"},{"type":"url","id":"link","label":"Enlace"}]}],"max_blocks":6,"presets":[{"name":"Destinos destacados","blocks":[{"type":"destination","settings":{"region":"Cusco · Andes","name":"Machu Picchu","description":"Historia viva, arquitectura inca y paisajes que parecen detener el tiempo.","fallback_image":"https://commons.wikimedia.org/wiki/Special:FilePath/Panorama_of_Machu_Picchu.jpg?width=1000"}},{"type":"destination","settings":{"region":"Ica · Costa sur","name":"Oasis de Huacachina","description":"Dunas doradas, aventura en el desierto y atardeceres junto a la laguna.","fallback_image":"https://commons.wikimedia.org/wiki/Special:FilePath/Oasis_Huacachina_-_Peru.jpg?width=1000"}},{"type":"destination","settings":{"region":"Cusco · Vilcanota","name":"Montaña de 7 colores","description":"Una ruta de altura entre paisajes minerales y vistas inolvidables.","fallback_image":"https://commons.wikimedia.org/wiki/Special:FilePath/Rainbow_Mountain_Peru.jpg?width=1000"}}]}]}{% endschema %}