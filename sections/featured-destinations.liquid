{% style %}.destinations{padding:95px 5vw;background:var(--cream)}.section-wrap{max-width:1320px;margin:auto}.section-kicker{color:var(--emerald);font-size:.76rem;letter-spacing:.18em;text-transform:uppercase}.section-heading{font:400 clamp(2.4rem,4.4vw,4.2rem)/1.05 var(--display);color:var(--forest);max-width:700px;margin:14px 0}.section-intro{color:#637169;max-width:600px;line-height:1.75}.destination-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:48px}.destination-image{display:block;aspect-ratio:4/5;overflow:hidden;border-radius:4px;background:#e6e9e1}.destination-image img{width:100%;height:100%;object-fit:cover;transition:transform .65s}.destination-card:hover img{transform:scale(1.04)}.destination-meta{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:#718078;margin:19px 0 7px}.destination-name{font:400 1.8rem var(--display);color:var(--forest);margin:0}.destination-desc{font-size:.92rem;line-height:1.65;color:#65736b}@media(max-width:800px){.destination-grid{grid-template-columns:1fr 1fr}.destinations{padding:70px 5vw}}@media(max-width:520px){.destination-grid{grid-template-columns:1fr}.destination-image{aspect-ratio:5/4}}{% endstyle %}<section class="destinations" id="destinos"><div class="section-wrap"><p class="section-kicker">{{ section.settings.kicker | escape }}</p><h2 class="section-heading">{{ section.settings.heading | escape }}</h2><p class="section-intro">{{ section.settings.intro | escape }}</p><div class="destination-grid">{% for block in section.blocks %}<article class="destination-card" {{ block.shopify_attributes }}><a class="destination-image" href="{{ block.settings.link | default: routes.root_url }}">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.image.alt }}{% else %}<img src="{{ block.settings.fallback_image }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="900" height="1100">{% endif %}</a><p class="destination-meta">{{ block.settings.region | escape }}</p><h3 class="destination-name">{{ block.settings.name | escape }}</h3><p class="destination-desc">{{ block.settings.description | escape }}</p></article>{% endfor %}</div></div></section>{% schema %}{"name":"Destinos destacados","settings":[{"type":"text","id":"kicker","label":"Antetítulo","default":"Inspiración para tu próxima ruta"},{"type":"text","id":"heading","label":"Título","default":"Lugares que hacen único al Perú."},{"type":"textarea","id":"intro","label":"Introducción","default":"Desde ciudades milenarias hasta oasis entre dunas y montañas de colores: descubre destinos que invitan a explorar."}],"blocks":[{"type":"destination","name":"Destino","settings":[{"type":"image_picker","id":"image","label":"Fotografía"},{"type":"text","id":"fallback_image","label":"URL de fotografía alternativa"},{"type":"text","id":"region","label":"Región","default":"Cusco · Andes"},{"type":"text","id":"name","label":"Nombre","default":"Machu Picchu"},{"type":"textarea","id":"description","label":"Descripción"},{"type":"url","id":"link","label":"Enlace"}]}],"max_blocks":6,"presets":[{"name":"Destinos destacados","blocks":[{"type":"destination","settings":{"region":"Cusco · Andes","name":"Machu Picchu","fallback_image":"https://images.unsplash.com/photo-1526392060635-9d6019884377?auto=format&fit=crop&w=1000&q=85","description":"Historia viva, arquitectura inca y paisajes que parecen detener el tiempo."}},{"type":"destination","settings":{"region":"Ica · Costa sur","name":"Oasis de Huacachina","fallback_image":"https://images.unsplash.com/photo-1530789253388-582c481c54b0?auto=format&fit=crop&w=1000&q=85","description":"Dunas doradas, aventura en el desierto y atardeceres junto a la laguna."}},{"type":"destination","settings":{"region":"Cusco · Vilcanota","name":"Montaña de 7 colores","fallback_image":"https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1000&q=85","description":"Una ruta de altura entre paisajes minerales y vistas inolvidables."}}]}]}{% endschema %}