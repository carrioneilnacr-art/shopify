{% style %}.site-footer{background:var(--forest);color:white;padding:55px 5vw 26px}.footer-inner{max-width:1320px;margin:auto;display:grid;grid-template-columns:1.2fr 1fr;gap:35px}.footer-brand{font:2rem var(--display);margin:0 0 12px}.footer-copy{color:#d1d9d2;max-width:440px;line-height:1.7}.footer-links{display:flex;flex-wrap:wrap;gap:18px;justify-content:flex-end;align-content:start}.footer-links a{color:white;text-decoration:none}.footer-bottom{max-width:1320px;margin:35px auto 0;padding-top:20px;border-top:1px solid #ffffff33;font-size:.8rem;color:#c5d0c8}@media(max-width:700px){.footer-inner{grid-template-columns:1fr}.footer-links{justify-content:flex-start}}{% endstyle %}<footer class="site-footer"><div class="footer-inner"><div><p class="footer-brand">Perú Explora IA</p><p class="footer-copy">Descubre el Perú a tu propio ritmo. Encuentra inspiración, información útil y nuevas rutas para tu próxima aventura.</p></div><nav class="footer-links" aria-label="Enlaces del pie"><a href="{{ routes.root_url }}#destinos">Destinos</a><a href="{{ routes.root_url }}#planifica">Planificador IA</a>{% if settings.contact_email != blank %}<a href="mailto:{{ settings.contact_email | escape }}">Contacto</a>{% endif %}{% if settings.instagram_url != blank %}<a href="{{ settings.instagram_url }}">Instagram</a>{% endif %}</nav></div><div class="footer-bottom">© {{ 'now' | date: '%Y' }} Perú Explora IA · Información turística sujeta a verificación con fuentes y operadores oficiales.</div></footer>{% schema %}{"name":"Pie de página","settings":[]}{% endschema %}