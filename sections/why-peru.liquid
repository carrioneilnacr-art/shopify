{% style %}.why-section{padding:clamp(75px,9vw,120px) 5vw;background:#e9eee6}.why-wrap{max-width:1320px;margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:clamp(35px,7vw,90px);align-items:center}.why-image{min-height:500px;overflow:hidden;border-radius:4px;background:#dce5db}.why-image img{width:100%;height:100%;min-height:500px;object-fit:cover}.why-copy h2{font:400 clamp(2.5rem,4.4vw,4.2rem)/1.05 var(--display);color:var(--forest);letter-spacing:-.04em;margin:14px 0}.why-copy>p{color:#617168;line-height:1.85}.why-list{display:grid;gap:15px;margin:28px 0 32px;padding:0;list-style:none}.why-list li{display:flex;gap:12px;color:#294b3d;line-height:1.55}.why-list li:before{content:'✦';color:#a58a53}@media(max-width:800px){.why-wrap{grid-template-columns:1fr}.why-image,.why-image img{min-height:330px}.why-section{padding:70px 5vw}}{% endstyle %}<section class="why-section"><div class="why-wrap"><div class="why-image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(min-width: 800px) 45vw, 90vw', loading: 'lazy', alt: section.settings.image.alt }}{% else %}<img src="https://commons.wikimedia.org/wiki/Special:FilePath/Tambopata.jpg?width=1200" alt="Paisaje natural de Tambopata, Madre de Dios, Perú" width="1200" height="1500" loading="lazy">{% endif %}</div><div class="why-copy"><p class="section-kicker">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p><ul class="why-list"><li>Información clara para conocer cada destino.</li><li>Ideas ajustadas a tus días y presupuesto.</li><li>Recomendaciones que puedes revisar y adaptar.</li></ul><a class="button-primary" href="#planifica">{{ section.settings.button_label | escape }}</a></div></div></section>{% schema %}{"name":"Nuestra propuesta editorial","settings":[{"type":"image_picker","id":"image","label":"Fotografía"},{"type":"text","id":"kicker","label":"Antetítulo","default":"Viajar informado también es viajar mejor"},{"type":"text","id":"heading","label":"Título","default":"Tu próxima historia empieza en el Perú."},{"type":"textarea","id":"body","label":"Descripción","default":"Queremos acercarte a los destinos del país con inspiración, contexto y herramientas inteligentes para que puedas planificar con más claridad."},{"type":"text","id":"button_label","label":"Botón","default":"Planificar mi viaje"}],"presets":[{"name":"Nuestra propuesta editorial"}]}{% endschema %}