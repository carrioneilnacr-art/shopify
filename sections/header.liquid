{% style %}.site-header{position:sticky;top:0;z-index:30;background:rgba(250,249,245,.96);backdrop-filter:blur(14px);border-bottom:1px solid #e9e9e2}.header-inner{width:min(1320px,90%);margin:auto;min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{font:1.5rem var(--display);letter-spacing:-.04em;color:var(--forest);text-decoration:none;white-space:nowrap}.brand span{color:var(--gold)}.site-nav{display:flex;align-items:center;gap:clamp(16px,2.5vw,34px)}.site-nav a{font-size:.88rem;color:var(--ink);text-decoration:none;min-height:44px;display:inline-flex;align-items:center}.site-nav a:hover{color:var(--emerald)}.header-cta{background:var(--forest);color:white!important;padding:12px 19px;border-radius:99px}.menu-toggle{display:none;border:1px solid #d9e1d8;background:transparent;border-radius:50%;width:46px;height:46px;color:var(--forest);font-size:1.25rem}@media(max-width:760px){.header-inner{min-height:70px}.menu-toggle{display:grid;place-items:center}.site-nav{display:none;position:absolute;top:100%;left:0;right:0;background:var(--cream);padding:16px 5vw 24px;flex-direction:column;align-items:stretch;gap:8px;border-bottom:1px solid #e4e8df;box-shadow:0 18px 24px #102d2017}.site-nav.is-open{display:flex}.site-nav a{min-height:48px}.header-cta{text-align:center;justify-content:center}.brand{font-size:1.3rem}}{% endstyle %}<header class="site-header"><div class="header-inner"><a class="brand" href="{{ routes.root_url }}">Perú Explora<span> IA</span></a><button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="MainNav"><span aria-hidden="true">☰</span></button><nav class="site-nav" id="MainNav" aria-label="Navegación principal"><a href="{{ routes.root_url }}#destinos">Destinos</a><a href="{{ routes.root_url }}#experiencias">Experiencias</a><a href="{{ routes.root_url }}#planifica">Planifica con IA</a><a href="{{ routes.root_url }}#preguntas">Preguntas frecuentes</a><a class="header-cta" href="{{ routes.root_url }}#planifica">Diseña tu viaje</a></nav></div></header><script>(function(){var b=document.querySelector('.menu-toggle'),n=document.querySelector('#MainNav');if(b&&n&&!b.dataset.ready){b.dataset.ready='1';b.addEventListener('click',function(){var open=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!open));b.setAttribute('aria-label',open?'Abrir menú':'Cerrar menú');n.classList.toggle('is-open',!open);});n.addEventListener('click',function(e){if(e.target.closest('a')){n.classList.remove('is-open');b.setAttribute('aria-expanded','false');b.setAttribute('aria-label','Abrir menú');}});}})();</script>{% schema %}{"name":"Encabezado","settings":[]} {% endschema %}