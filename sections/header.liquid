{% style %}.site-header{position:sticky;top:0;z-index:20;background:rgba(250,249,245,.95);backdrop-filter:blur(14px);border-bottom:1px solid #e9e9e2}.header-inner{max-width:1320px;margin:auto;padding:0 5vw;min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{font:1.45rem var(--display);color:var(--forest);text-decoration:none}.brand span{color:var(--gold)}.site-nav{display:flex;align-items:center;gap:28px}.site-nav a{font-size:.9rem;color:var(--ink);text-decoration:none}.site-nav a:hover{color:var(--emerald)}.header-cta{background:var(--forest);color:white!important;padding:12px 19px;border-radius:99px}.menu-toggle{display:none;border:0;background:none;font-size:1.5rem;color:var(--forest)}@media(max-width:760px){.header-inner{min-height:68px}.menu-toggle{display:block}.site-nav{display:none;position:absolute;top:100%;left:0;right:0;background:var(--cream);padding:20px 5vw 26px;flex-direction:column;align-items:stretch;gap:18px}.site-nav.is-open{display:flex}.header-cta{text-align:center}}{% endstyle %}<header class="site-header"><div class="header-inner"><a class="brand" href="{{ routes.root_url }}">Perú Explora<span> IA</span></a><button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="MainNav">☰</button><nav class="site-nav" id="MainNav" aria-label="Navegación principal"><a href="{{ routes.root_url }}#destinos">Destinos</a><a href="{{ routes.root_url }}#planifica">Planifica con IA</a><a href="{{ routes.root_url }}#nosotros">Nuestra propuesta</a><a class="header-cta" href="{{ routes.root_url }}#planifica">Diseña tu viaje</a></nav></div></header><script>document.addEventListener('DOMContentLoaded',function(){var b=document.querySelector('.menu-toggle'),n=document.querySelector('#MainNav');if(b&&n)b.addEventListener('click',function(){var o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));n.classList.toggle('is-open',!o);});});</script>{% schema %}{"name":"Encabezado","settings":[]}{% endschema %}