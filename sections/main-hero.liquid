{% style %}.hero-peru{min-height:660px;position:relative;display:flex;align-items:flex-end;overflow:hidden;background:#183c30;color:white}.hero-peru>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-peru:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#051812b8,#05181220),linear-gradient(0deg,#05181277,transparent 60%)}.hero-content{position:relative;z-index:1;width:min(1320px,90%);margin:auto;padding:110px 0 82px}.hero-eyebrow{letter-spacing:.2em;text-transform:uppercase;font-size:.76rem;color:#ead9b5}.hero-title{font:400 clamp(3.2rem,7.2vw,6.8rem)/.99 var(--display);letter-spacing:-.045em;max-width:900px;margin:22px 0}.hero-subtitle{font-size:1.1rem;line-height:1.7;max-width:580px;color:#ffffffe0}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.hero-btn{display:inline-flex;padding:15px 24px;border-radius:99px;text-decoration:none;font-weight:600;background:white;color:var(--forest)}.hero-btn.secondary{background:transparent;color:white;border:1px solid #ffffffb3}@media(max-width:700px){.hero-peru{min-height:590px}.hero-content{padding:90px 0 55px}}{% endstyle %}<section class="hero-peru">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt }}{% else %}<img src="https://images.unsplash.com/photo-1526392060635-9d6019884377?auto=format&fit=crop&w=2400&q=85" alt="Machu Picchu, Cusco, Perú" width="2400" height="1600" fetchpriority="high">{% endif %}<div class="hero-content"><p class="hero-eyebrow">{{ section.settings.eyebrow | escape }}</p><h1 class="hero-title">{{ section.settings.title | escape }}</h1><p class="hero-subtitle">{{ section.settings.subtitle | escape }}</p><div class="hero-actions"><a class="hero-btn" href="{{ section.settings.primary_link | default: '#destinos' }}">{{ section.settings.primary_label | escape }}</a><a class="hero-btn secondary" href="{{ section.settings.secondary_link | default: '#planifica' }}">{{ section.settings.secondary_label | escape }}</a></div></div></section>{% schema %}{"name":"Hero editorial Perú","settings":[{"type":"image_picker","id":"image","label":"Fotografía principal"},{"type":"text","id":"eyebrow","label":"Texto superior","default":"Viajes con sentido · Perú"},{"type":"textarea","id":"title","label":"Título","default":"El Perú se descubre con otros ojos."},{"type":"textarea","id":"subtitle","label":"Descripción","default":"Encuentra lugares extraordinarios, conoce sus historias y empieza a imaginar tu próxima aventura por el Perú."},{"type":"text","id":"primary_label","label":"Botón principal","default":"Explorar destinos"},{"type":"url","id":"primary_link","label":"Enlace principal"},{"type":"text","id":"secondary_label","label":"Botón secundario","default":"Planificar con IA"},{"type":"url","id":"secondary_link","label":"Enlace secundario"}],"presets":[{"name":"Hero editorial Perú"}]}{% endschema %}