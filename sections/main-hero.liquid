{% style %}
.hero-peru{min-height:min(760px,82svh);position:relative;display:flex;align-items:flex-end;overflow:hidden;background:#173d30;color:white}
.hero-peru>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 48%}
.hero-peru:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,24,18,.75),rgba(5,24,18,.08) 85%),linear-gradient(0deg,rgba(5,24,18,.52),transparent 65%)}
.hero-content{position:relative;z-index:1;width:min(1320px,90%);margin:0 auto;padding:clamp(90px,13vw,160px) 0 76px}
.hero-eyebrow{letter-spacing:.2em;text-transform:uppercase;font-size:.74rem;color:#ead9b5}
.hero-title{font:400 clamp(3.1rem,7.5vw,7rem)/.98 var(--display);letter-spacing:-.05em;max-width:920px;margin:20px 0}
.hero-subtitle{font-size:clamp(1rem,1.5vw,1.15rem);line-height:1.75;max-width:580px;color:rgba(255,255,255,.9)}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.hero-btn{display:inline-flex;min-height:50px;align-items:center;justify-content:center;padding:14px 24px;border-radius:99px;text-decoration:none;font-weight:600;background:#fff;color:var(--forest);transition:transform .2s,background .2s}
.hero-btn:hover{transform:translateY(-2px);background:#f0eee5}
.hero-btn.secondary{background:transparent;color:white;border:1px solid rgba(255,255,255,.8)}
.hero-caption{margin-top:42px;font-size:.75rem;letter-spacing:.06em;color:#ffffffc7}
@media(max-width:700px){.hero-peru{min-height:680px;min-height:78svh}.hero-content{padding:100px 0 48px}.hero-title{font-size:clamp(3rem,14vw,4.6rem)}.hero-actions{display:grid;grid-template-columns:1fr}.hero-btn{width:100%}}
{% endstyle %}
<section class="hero-peru" aria-labelledby="HeroTitle">
{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2000 | image_tag: widths: '600, 900, 1200, 1600, 2000', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt }}{% else %}<img src="https://commons.wikimedia.org/wiki/Special:FilePath/Panorama_of_Machu_Picchu.jpg?width=1800" alt="Vista panorámica real de Machu Picchu, Cusco, Perú" width="1800" height="700" fetchpriority="high">{% endif %}
<div class="hero-content"><p class="hero-eyebrow">{{ section.settings.eyebrow | escape }}</p><h1 class="hero-title" id="HeroTitle">{{ section.settings.title | escape }}</h1><p class="hero-subtitle">{{ section.settings.subtitle | escape }}</p><div class="hero-actions"><a class="hero-btn" href="{{ section.settings.primary_link | default: '#destinos' }}">{{ section.settings.primary_label | escape }}</a><a class="hero-btn secondary" href="{{ section.settings.secondary_link | default: '#planifica' }}">{{ section.settings.secondary_label | escape }}</a></div><p class="hero-caption">Rutas, cultura y paisajes extraordinarios. Todo dentro del Perú.</p></div>
</section>
{% schema %}{"name":"Portada cinematográfica","settings":[{"type":"image_picker","id":"image","label":"Fotografía principal"},{"type":"text","id":"eyebrow","label":"Texto superior","default":"Viajes con sentido · Perú"},{"type":"textarea","id":"title","label":"Título","default":"El Perú se descubre con otros ojos."},{"type":"textarea","id":"subtitle","label":"Descripción","default":"Encuentra lugares extraordinarios, conoce sus historias y empieza a imaginar tu próxima aventura por el Perú."},{"type":"text","id":"primary_label","label":"Botón principal","default":"Explorar destinos"},{"type":"url","id":"primary_link","label":"Enlace principal"},{"type":"text","id":"secondary_label","label":"Botón secundario","default":"Planificar con IA"},{"type":"url","id":"secondary_link","label":"Enlace secundario"}],"presets":[{"name":"Portada cinematográfica"}]}{% endschema %}