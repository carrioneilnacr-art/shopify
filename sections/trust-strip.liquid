{% style %}.trust-strip{background:#f0f2eb;border-bottom:1px solid #e4e8df}.trust-inner{width:min(1320px,90%);margin:auto;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;padding:22px 0}.trust-item{display:flex;align-items:center;justify-content:center;gap:12px;color:#294b3d;font-size:.86rem;font-weight:600}.trust-mark{width:28px;height:28px;display:grid;place-items:center;border:1px solid #b6c7b7;border-radius:50%;color:#426c52}@media(max-width:700px){.trust-inner{grid-template-columns:1fr;gap:12px;padding:20px 0}.trust-item{justify-content:flex-start}}{% endstyle %}<section class="trust-strip" aria-label="Nuestra propuesta"><div class="trust-inner"><div class="trust-item"><span class="trust-mark">✦</span> Turismo dentro del Perú</div><div class="trust-item"><span class="trust-mark">⌖</span> Ideas según tu forma de viajar</div><div class="trust-item"><span class="trust-mark">✧</span> Planificación asistida por IA</div></div></section>{% schema %}{"name":"Franja de confianza","settings":[],"presets":[{"name":"Franja de confianza"}]}{% endschema %}