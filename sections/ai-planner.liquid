{% style %}.ai-planner{background:var(--forest);color:white;padding:clamp(70px,9vw,115px) 5vw}.ai-wrap{max-width:1220px;margin:auto;display:grid;grid-template-columns:1fr .92fr;gap:clamp(35px,7vw,85px);align-items:center}.ai-kicker{font-size:.74rem;letter-spacing:.2em;text-transform:uppercase;color:#dfc99b}.ai-title{font:400 clamp(2.7rem,5vw,4.8rem)/1.03 var(--display);letter-spacing:-.04em;margin:18px 0}.ai-copy{line-height:1.85;color:#ffffffc7;max-width:560px}.ai-points{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:28px;font-size:.9rem;color:#f5f3eb}.ai-card{background:#faf9f5;color:#1d2b25;border-radius:8px;padding:clamp(22px,3vw,34px);box-shadow:0 20px 55px #071c1433}.ai-card h3{font:400 1.9rem var(--display);margin:0 0 7px;color:var(--forest)}.ai-card>p{color:#64736a;line-height:1.6}.ai-form{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin-top:22px}.ai-form label{display:block;font-size:.78rem;font-weight:600;color:#344c40}.ai-form label.full{grid-column:1/-1}.ai-form input,.ai-form select,.ai-form textarea{display:block;width:100%;min-height:48px;margin-top:6px;border:1px solid #dce2d9;background:white;border-radius:5px;padding:12px;font:inherit;color:#1d2b25}.ai-form textarea{min-height:88px;resize:vertical}.ai-submit{grid-column:1/-1;background:var(--emerald);color:white;border:0;border-radius:99px;min-height:50px;padding:14px 22px;font-weight:600;cursor:pointer}.ai-submit:disabled{opacity:.65;cursor:wait}.ai-result{display:none;grid-column:1/-1;margin-top:5px;padding:18px;background:#edf2eb;border:1px solid #dce5d8;border-radius:6px;color:#244333;white-space:pre-wrap;line-height:1.7;font-size:.9rem;overflow-wrap:anywhere}.ai-copy-button{display:none;grid-column:1/-1;justify-self:start;border:0;background:none;color:#174c3a;text-decoration:underline;cursor:pointer;padding:8px 0;font-weight:600}.ai-note{font-size:.72rem!important;color:#68776f!important;margin-top:15px}@media(max-width:850px){.ai-wrap{grid-template-columns:1fr;gap:35px}}@media(max-width:540px){.ai-form{grid-template-columns:1fr}.ai-form label.full,.ai-submit,.ai-result,.ai-copy-button{grid-column:1}.ai-points{grid-template-columns:1fr}.ai-card{padding:22px}.ai-title{font-size:clamp(2.6rem,12vw,3.6rem)}}{% endstyle %}
<section class="ai-planner" id="planifica"><div class="ai-wrap"><div><p class="ai-kicker">{{ section.settings.kicker | escape }}</p><h2 class="ai-title">{{ section.settings.heading | escape }}</h2><p class="ai-copy">{{ section.settings.body | escape }}</p><div class="ai-points"><span>✦ Ideas según tu presupuesto</span><span>✦ Rutas según tus días</span><span>✦ Experiencias según tus intereses</span><span>✦ Consejos para prepararte</span></div></div><div class="ai-card"><h3>{{ section.settings.card_title | escape }}</h3><p>{{ section.settings.card_subtitle | escape }}</p><form class="ai-form" data-ai-endpoint="{{ section.settings.endpoint | escape }}"><label>Ciudad de salida<input name="origin" required maxlength="80" placeholder="Ej. Lima"></label><label>Días de viaje<input name="days" type="number" min="1" max="30" required placeholder="Ej. 4"></label><label>Presupuesto por persona (S/)<input name="budget" type="number" min="50" max="100000" required placeholder="Ej. 900"></label><label>Número de viajeros<input name="travellers" type="number" min="1" max="20" required value="2"></label><label>Tipo de experiencia<select name="style"><option>Naturaleza y aventura</option><option>Cultura e historia</option><option>Gastronomía</option><option>Viaje en familia</option><option>Descanso y bienestar</option><option>Un poco de todo</option></select></label><label>Mes aproximado<select name="month"><option value="Flexible">Fechas flexibles</option><option>Enero - marzo</option><option>Abril - junio</option><option>Julio - septiembre</option><option>Octubre - diciembre</option></select></label><label class="full">¿Qué te gustaría vivir?<textarea name="interests" maxlength="700" placeholder="Ej. Viajo en pareja, prefiero caminatas suaves y gastronomía local..."></textarea></label><button class="ai-submit" type="submit">{{ section.settings.button_label | escape }}</button><div class="ai-result" role="status" aria-live="polite" aria-atomic="true"></div><button class="ai-copy-button" type="button">Copiar itinerario</button></form><p class="ai-note">Las propuestas son orientativas. Verifica tarifas, horarios, accesos, condiciones y disponibilidad con fuentes oficiales y proveedores antes de viajar.</p></div></div></section>
<script>(function(){function initPlanner(){document.querySelectorAll('.ai-form:not([data-ready])').forEach(function(form){form.dataset.ready='true';var submit=form.querySelector('.ai-submit'),out=form.querySelector('.ai-result'),copy=form.querySelector('.ai-copy-button');form.addEventListener('submit',async function(event){event.preventDefault();var endpoint=form.dataset.aiEndpoint;if(!endpoint){out.style.display='block';out.textContent='El planificador todavía no está conectado. Configura la URL del backend seguro en el editor de Shopify.';return;}submit.disabled=true;submit.textContent='Preparando tu ruta…';out.style.display='block';out.textContent='Estamos organizando una propuesta para tu viaje. Puede tardar unos segundos.';copy.style.display='none';try{var response=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(form).entries()))});var data=await response.json().catch(function(){return {};});if(!response.ok)throw new Error(data.error||'No pudimos generar la propuesta.');out.textContent=data.itinerary||'No recibimos una propuesta. Inténtalo nuevamente.';copy.style.display='inline-flex';}catch(error){out.textContent=error.message||'No pudimos conectar con el planificador. Inténtalo más tarde.';}finally{submit.disabled=false;submit.textContent='{{ section.settings.button_label | escape }}';}});copy.addEventListener('click',async function(){try{await navigator.clipboard.writeText(out.textContent);copy.textContent='Itinerario copiado';}catch(e){copy.textContent='No se pudo copiar';}});});}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',initPlanner);}else{initPlanner();}})();</script>
{% schema %}{"name":"Planificador turístico IA","settings":[{"type":"text","id":"kicker","label":"Antetítulo","default":"Tu viaje, pensado contigo"},{"type":"text","id":"heading","label":"Título","default":"Una gran aventura empieza con una buena idea."},{"type":"textarea","id":"body","label":"Descripción","default":"Cuéntanos cuánto tiempo tienes, desde dónde sales y qué te gustaría vivir. Nuestro asistente te ayudará a convertir esas ideas en una ruta posible por el Perú."},{"type":"text","id":"card_title","label":"Título del formulario","default":"Diseña tu próxima ruta"},{"type":"text","id":"card_subtitle","label":"Subtítulo","default":"Cuéntanos cómo te gustaría viajar por el Perú."},{"type":"text","id":"button_label","label":"Texto del botón","default":"Crear mi propuesta de viaje"},{"type":"url","id":"endpoint","label":"URL del backend seguro de OpenAI","info":"Pega aquí la URL HTTPS del backend. Nunca coloques tu API key aquí."}],"presets":[{"name":"Planificador turístico IA"}]}{% endschema %}