{% style %}.ai-planner{background:var(--forest);color:white;padding:95px 5vw}.ai-wrap{max-width:1220px;margin:auto;display:grid;grid-template-columns:1fr .9fr;gap:65px;align-items:center}.ai-kicker{font-size:.75rem;letter-spacing:.2em;text-transform:uppercase;color:#d8c59d}.ai-title{font:400 clamp(2.7rem,4.8vw,4.8rem)/1.04 var(--display);margin:18px 0}.ai-copy{line-height:1.8;color:#ffffffc2}.ai-points{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:28px;font-size:.9rem}.ai-card{background:#faf9f5;color:#1d2b25;border-radius:8px;padding:28px}.ai-card h3{font:400 1.8rem var(--display);margin:0 0 7px}.ai-card p{color:#64736a;line-height:1.6}.ai-form{display:grid;gap:13px;margin-top:20px}.ai-form label{font-size:.82rem;font-weight:600}.ai-form input,.ai-form select,.ai-form textarea{display:block;width:100%;margin-top:6px;border:1px solid #dce2d9;background:white;border-radius:5px;padding:12px;font:inherit;color:#1d2b25}.ai-submit{background:var(--emerald);color:white;border:0;border-radius:99px;padding:15px 22px;font-weight:600;cursor:pointer}.ai-result{display:none;margin-top:15px;padding:15px;background:#edf2eb;border-radius:5px;white-space:pre-wrap;line-height:1.6}.ai-note{font-size:.75rem!important}@media(max-width:800px){.ai-wrap{grid-template-columns:1fr;gap:35px}.ai-planner{padding:70px 5vw}}{% endstyle %}<section class="ai-planner" id="planifica"><div class="ai-wrap"><div><p class="ai-kicker">{{ section.settings.kicker | escape }}</p><h2 class="ai-title">{{ section.settings.heading | escape }}</h2><p class="ai-copy">{{ section.settings.body | escape }}</p><div class="ai-points"><span>✦ Ideas según tu presupuesto</span><span>✦ Rutas según tus días</span><span>✦ Experiencias según tus intereses</span><span>✦ Consejos para prepararte</span></div></div><div class="ai-card"><h3>{{ section.settings.card_title | escape }}</h3><p>{{ section.settings.card_subtitle | escape }}</p><form class="ai-form" data-ai-endpoint="{{ section.settings.endpoint | escape }}"><label>¿Desde dónde viajas?<input name="origin" required placeholder="Ej. Lima"></label><label>¿Cuántos días tienes?<input name="days" type="number" min="1" max="30" required placeholder="Ej. 4"></label><label>Presupuesto aproximado (S/)<input name="budget" type="number" min="0" required placeholder="Ej. 800"></label><label>¿Qué experiencia buscas?<select name="style"><option>Naturaleza y aventura</option><option>Cultura e historia</option><option>Gastronomía</option><option>Viaje en familia</option><option>Descanso y bienestar</option></select></label><label>Cuéntanos un poco más<textarea name="interests" rows="2" placeholder="Viajo en pareja, prefiero caminatas suaves..."></textarea></label><button class="ai-submit" type="submit">{{ section.settings.button_label | escape }}</button><div class="ai-result" role="status" aria-live="polite"></div></form><p class="ai-note">Las propuestas son orientativas. Verifica precios, horarios, accesos y disponibilidad con fuentes oficiales y proveedores antes de viajar.</p></div></div></section><script>document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('.ai-form').forEach(function(form){form.addEventListener('submit',async function(e){e.preventDefault();var out=form.querySelector('.ai-result'),endpoint=form.dataset.aiEndpoint;out.style.display='block';if(!endpoint){out.textContent='El planificador está preparado. Para activar recomendaciones automáticas, el administrador debe conectar un backend seguro con OpenAI en la configuración de esta sección.';return;}var data=Object.fromEntries(new FormData(form).entries());out.textContent='Preparando tu propuesta…';try{var res=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});if(!res.ok)throw new Error();var json=await res.json();out.textContent=json.itinerary||json.answer||'No recibimos una propuesta. Inténtalo de nuevo.';}catch(err){out.textContent='No pudimos conectar con el planificador en este momento. Inténtalo más tarde.';}});});});</script>{% schema %}{"name":"Planificador turístico IA","settings":[{"type":"text","id":"kicker","label":"Antetítulo","default":"Tu viaje, pensado contigo"},{"type":"text","id":"heading","label":"Título","default":"Una gran aventura empieza con una buena idea."},{"type":"textarea","id":"body","label":"Descripción","default":"Cuéntanos cuánto tiempo tienes, desde dónde sales y qué te gustaría vivir. Nuestro planificador te ayudará a convertir esas ideas en una ruta posible."},{"type":"text","id":"card_title","label":"Título del formulario","default":"Diseña tu próxima ruta"},{"type":"text","id":"card_subtitle","label":"Subtítulo","default":"Cuéntanos cómo te gustaría viajar por el Perú."},{"type":"text","id":"button_label","label":"Texto del botón","default":"Crear mi propuesta de viaje"},{"type":"url","id":"endpoint","label":"URL del backend seguro de OpenAI","info":"Pega aquí la URL HTTPS de tu backend. Nunca coloques tu API key en este campo."}],"presets":[{"name":"Planificador turístico IA"}]}{% endschema %}