<section style="max-width:900px;margin:65px auto;padding:0 5vw"><h1 class="section-heading">Tu carrito</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><ul>{% for item in cart.items %}<li style="padding:18px 0;border-bottom:1px solid #ddd">{{ item.product.title | escape }} · {{ item.final_line_price | money }} <label>Cantidad <input name="updates[]" type="number" min="0" value="{{ item.quantity }}"></label></li>{% endfor %}</ul><p>Total: {{ cart.total_price | money }}</p><button class="ai-submit" name="update">Actualizar</button><button class="ai-submit" name="checkout">Continuar</button></form>{% else %}<p>Tu carrito está vacío.</p><a href="{{ routes.root_url }}#destinos">Explorar destinos</a>{% endif %}</section>{% schema %}{"name":"Carrito","settings":[]}{% endschema %}