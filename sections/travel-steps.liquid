{% style %}.steps-section{padding:clamp(70px,8vw,105px) 5vw;background:#fff}.steps-wrap{max-width:1320px;margin:auto}.steps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:45px}.step-card{border-top:1px solid #d8dfd6;padding-top:22px}.step-number{font:400 2.4rem var(--display);color:#b79a62}.step-card h3{font:400 1.65rem var(--display);color:var(--forest);margin:14px 0 9px}.step-card p{color:#68776f;line-height:1.75;font-size:.92rem;max-width:360px}@media(max-width:700px){.steps-grid{grid-template-columns:1fr;gap:24px}.step-card{padding-top:16px}}{% endstyle %}<section class="steps-section"><div class="steps-wrap"><p class="section-kicker">{{ section.settings.kicker | escape }}</p><h2 class="section-heading">{{ section.settings.heading | escape }}</h2><div class="steps-grid">{% for block in section.blocks %}<article class="step-card" {{ block.shopify_attributes }}><span class="step-number">0{{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.body | escape }}</p></article>{% endfor %}</div></div></section>{% schema %}{"name":"Cómo funciona","settings":[{"type":"text","id":"kicker","label":"Antetítulo","default":"Planifica sin complicarte"},{"type":"text","id":"heading","label":"Título","default":"De la idea a tu próxima aventura."}],"blocks":[{"type":"step","name":"Paso","settings":[{"type":"text","id":"title","label":"Título","default":"Cuéntanos qué buscas"},{"type":"textarea","id":"body","label":"Descripción","default":"Comparte tu punto de partida, presupuesto, días e intereses."}]}],"max_blocks":3,"presets":[{"name":"Cómo funciona","blocks":[{"type":"step","settings":{"title":"Cuéntanos qué buscas","body":"Comparte tu punto de partida, presupuesto, días e intereses."}},{"type":"step","settings":{"title":"Recibe una ruta sugerida","body":"La IA organiza ideas y destinos en un itinerario que puedes ajustar."}},{"type":"step","settings":{"title":"Verifica y prepárate","body":"Comprueba tarifas, horarios y disponibilidad con proveedores oficiales antes de viajar."}}]}]}{% endschema %}